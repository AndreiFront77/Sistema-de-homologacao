{
  "name": "sistema-homologacao",
  "version": "1.0.0",
  "description": "Ferramenta de homologação local com desktop app",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm --prefix local-backend start\" \"ng serve\"",
    "start:electron": "npm run build && electron .",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:4200 && electron .\"",
    "desktop:build": "npm run build:prod && electron-builder --win --publish=never",
    "desktop:build:installer": "npm run build:prod && electron-builder --win -p never",
    "desktop:build:portable": "npm run build:prod && electron-builder --win portable -p never"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^3.0.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.sistemahomologacao.app",
    "productName": "Sistema de Homologação",
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "dist/sistema-homologacao/**/*",
      "electron/**/*",
      "local-backend/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Homologação"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
